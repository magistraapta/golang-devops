# Local directory used by terraform init
.terraform/

# Local state files and backups
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Variables files containing potentially sensitive data
*.tfvars
*.tfvars.json

# Local override files 
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock

# Saved execution plans
*.tfplan

# CLI configuration and crash logs
.terraformrc
terraform.rc
crash.log
